# Database
DATABASE_URL="postgresql://user:password@localhost:5432/magazin_my?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars

# Payment
# Use mock for local checkout testing, rollypay for production.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=RUB
ROLLYPAY_API_URL=https://rollypay.io
ROLLYPAY_API_KEY=your_rollypay_api_key
ROLLYPAY_WEBHOOK_SECRET=your_rollypay_signing_secret_at_least_32_chars

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Digital Store"

# Optional admin bootstrap. Use only for initial setup or explicit password rotation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_BOOTSTRAP_UPDATE_PASSWORD=false

# File Storage
UPLOAD_DIR=./public/uploads
DOWNLOAD_DIR=./private/downloads
MESSAGE_UPLOAD_DIR=./uploads/messages

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# WebSocket Server
WS_JWT_SECRET=your_ws_jwt_secret_at_least_32_chars
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Production WebSocket URL (uncomment for production)
# NEXT_PUBLIC_WS_URL=wss://ws.your-domain.com
