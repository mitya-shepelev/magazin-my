# Staging environment template for Dockhand.
# Copy these values into Dockhand staging environment settings and replace every CHANGE_ME value.
# Do not commit real staging secrets.

# Stack ports on the staging host. Change if another stack already uses these ports.
APP_PORT=3000
WS_PORT=3001

# PostgreSQL
POSTGRES_DB=magazin_staging
POSTGRES_USER=magazin_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD

# NextAuth
NEXTAUTH_URL=https://staging.example.com
NEXTAUTH_SECRET=CHANGE_ME_STAGING_NEXTAUTH_SECRET_AT_LEAST_32_CHARS

# Public application URLs
NEXT_PUBLIC_APP_URL=https://staging.example.com
NEXT_PUBLIC_WS_URL=wss://ws-staging.example.com
NEXT_PUBLIC_APP_NAME=Digital Store Staging

# Redis
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD

# WebSocket shared secret. Must match app and ws services.
WS_JWT_SECRET=CHANGE_ME_STAGING_WS_JWT_SECRET_AT_LEAST_32_CHARS

# Optional admin bootstrap. Use Dockhand secrets for ADMIN_PASSWORD.
ADMIN_EMAIL=admin@staging.example.com
ADMIN_PASSWORD=CHANGE_ME_STAGING_ADMIN_PASSWORD
ADMIN_NAME=Administrator
# Keep false for normal deploys. Set true only when intentionally rotating the admin password.
ADMIN_BOOTSTRAP_UPDATE_PASSWORD=false

# Payments
# deploy/dockhand/compose.prod.yml runs NODE_ENV=production, so PAYMENT_PROVIDER=mock
# is intentionally rejected by runtime validation. Use RollyPay sandbox/test credentials
# if available, or a dedicated non-production compose override for mock-only staging.
PAYMENT_PROVIDER=rollypay
PAYMENT_CURRENCY=RUB
ROLLYPAY_API_URL=https://rollypay.io
ROLLYPAY_API_KEY=CHANGE_ME_STAGING_ROLLYPAY_API_KEY
ROLLYPAY_WEBHOOK_SECRET=CHANGE_ME_STAGING_ROLLYPAY_WEBHOOK_SECRET_AT_LEAST_32_CHARS
