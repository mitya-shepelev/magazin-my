# Docker Desktop full-stack smoke environment.
# This file is intentionally local-only and uses mock payments.

APP_PORT=3100
WS_PORT=3101

POSTGRES_DB=magazin_docker
POSTGRES_USER=magazin
POSTGRES_PASSWORD=magazin_docker_password

NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=docker-local-nextauth-secret-at-least-32-chars
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_WS_URL=ws://localhost:3101
NEXT_PUBLIC_APP_NAME=Digital Store Docker

REDIS_PASSWORD=
WS_JWT_SECRET=docker-local-ws-secret-at-least-32-chars

PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=RUB
ROLLYPAY_API_URL=https://rollypay.io
ROLLYPAY_API_KEY=
ROLLYPAY_WEBHOOK_SECRET=docker-local-webhook-secret-at-least-32-chars

# Optional local admin bootstrap. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_BOOTSTRAP_UPDATE_PASSWORD=false
