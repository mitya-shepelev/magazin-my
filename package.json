{
  "name": "magazin-my.servbay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u PGHOST WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 next dev --webpack",
    "build": "env -u PGHOST next build",
    "start": "env -u PGHOST next start",
    "lint": "eslint",
    "smoke:critical": "dotenv -e .env -- env -u PGHOST npx tsx scripts/smoke-critical-flows.ts",
    "smoke:auth-checkout": "dotenv -e .env -- env -u PGHOST npx tsx scripts/smoke-auth-checkout.ts",
    "smoke:admin-api": "dotenv -e .env -- env -u PGHOST npx tsx scripts/smoke-admin-api.ts",
    "smoke:api-security": "dotenv -e .env -- env -u PGHOST npx tsx scripts/smoke-api-security.ts",
    "db:migrate": "env -u PGHOST npx prisma migrate dev",
    "db:push": "env -u PGHOST npx prisma db push",
    "db:studio": "env -u PGHOST npx prisma studio",
    "db:seed": "env -u PGHOST npx tsx scripts/create-admin.ts",
    "db:seed:demo": "env -u PGHOST npx tsx src/scripts/seed.ts",
    "docker:local": "node scripts/docker-local.mjs",
    "docker:local:up": "node scripts/docker-local.mjs up -d",
    "docker:local:down": "node scripts/docker-local.mjs down",
    "docker:local:ps": "node scripts/docker-local.mjs ps"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "react-markdown": "^10.1.0",
    "slugify": "^1.6.6",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
