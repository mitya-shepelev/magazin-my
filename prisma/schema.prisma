// Prisma Schema для магазина цифровых товаров
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// ==================== ПОЛЬЗОВАТЕЛИ ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("CUSTOMER") // ADMIN, CUSTOMER
  orders        Order[]
  licenses      License[]
  orderMessages OrderMessage[]
  stageComments StageComment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==================== КАТЕГОРИИ ====================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  seo         SeoMeta?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==================== ТОВАРЫ ====================

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  shortDesc     String?     // Краткое описание
  description   String      // Полное описание
  price         Float
  oldPrice      Float?      // Старая цена для скидок
  images        String      // JSON массив изображений
  downloadFile  String      // Приватный пакет для установки администратором
  demoUrl       String?     // Ссылка на демо
  version       String?     // Версия продукта
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  seo           SeoMeta?
  orderItems    OrderItem[]
  licenses      License[]
  stageTemplates StageTemplate[]
  productType   String      @default("WEB_APP") // WEB_APP, MOBILE_APP
  features      String?     // JSON массив характеристик
  isActive      Boolean     @default(true)
  isFeatured    Boolean     @default(false) // Рекомендуемый товар
  downloads     Int         @default(0) // Legacy counter: purchases/installations
  supportDays   Int         @default(30) // Дней поддержки после установки
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==================== SEO ====================

model SeoMeta {
  id            String    @id @default(cuid())
  title         String    // Мета-заголовок
  description   String    // Мета-описание
  keywords      String    // Ключевые слова через запятую
  canonicalUrl  String?   // Канонический URL
  ogImage       String?   // Open Graph изображение
  productId     String?   @unique
  product       Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId    String?   @unique
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==================== ЗАКАЗЫ ====================

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // Номер заказа для отображения
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  licenses      License[]
  stages        InstallationStage[]
  messages      OrderMessage[]
  total         Float
  status        String      @default("PENDING") // PENDING, PAID, CANCELLED, REFUNDED
  installationStatus String @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, SUPPORT
  paymentId     String?     // Payment provider ID
  paymentMethod String?     // Payment provider/method
  customerEmail String      // Email для уведомлений
  customerName  String?
  notes         String?     // Примечания к заказу
  paidAt        DateTime?   // Дата оплаты
  supportEndsAt DateTime?   // Когда заканчивается поддержка
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==================== ПЛАТЕЖНЫЕ WEBHOOK СОБЫТИЯ ====================

model PaymentWebhookEvent {
  id               String    @id @default(cuid())
  provider         String
  eventKey         String    @unique
  eventType        String?
  status           String?
  orderId          String?
  paymentId        String?
  payloadHash      String
  processingStatus String    @default("RECEIVED") // RECEIVED, PROCESSED, IGNORED, FAILED
  error            String?   @db.Text
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  @@index([provider])
  @@index([orderId])
  @@index([paymentId])
  @@index([processingStatus])
  @@index([receivedAt])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  productName String    // Сохраняем название на момент покупки
  price       Float     // Сохраняем цену на момент покупки
  downloadKey String    @unique @default(cuid()) // Legacy key; client downloads are disabled
  downloadCount Int     @default(0) // Legacy download count
  license     License?
  createdAt   DateTime  @default(now())
}

// ==================== ЛИЦЕНЗИИ ====================

model License {
  id              String    @id @default(cuid())
  licenseKey      String    @unique
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String    @unique
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  domain          String?
  serverIp        String?
  maxActivations  Int       @default(1)
  activationCount Int       @default(0)
  activatedAt     DateTime?
  lastCheckAt     DateTime?
  events          LicenseEvent[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([productId])
  @@index([status])
}

model LicenseEvent {
  id        String   @id @default(cuid())
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  eventType String   // ACTIVATION_SUCCESS, ACTIVATION_REJECTED, BINDING_UPDATED, BINDING_RESET, STATUS_CHANGED, KEY_REISSUED
  actorType String   @default("SYSTEM") // ADMIN, LICENSE_API, SYSTEM
  actorId   String?
  message   String?
  domain    String?
  serverIp  String?
  metadata  String?  // JSON string with small contextual details
  createdAt DateTime @default(now())

  @@index([licenseId])
  @@index([eventType])
  @@index([actorType])
  @@index([createdAt])
}

// ==================== НАСТРОЙКИ САЙТА ====================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== СТРАНИЦЫ (для SEO) ====================

model Page {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String?
  seoTitle    String?
  seoDesc     String?
  seoKeywords String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ==================== ОТЗЫВЫ ====================

model Review {
  id        String   @id @default(cuid())
  name      String   // Имя клиента
  company   String?  // Компания (опционально)
  text      String   // Текст отзыва
  rating    Int      @default(5) // Рейтинг 1-5
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== ЭТАПЫ УСТАНОВКИ ====================

// Шаблон этапа для товара
model StageTemplate {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String   // Название этапа
  description String   @db.Text // Описание что нужно сделать (markdown)
  type        String   // CLIENT_ACTION, ADMIN_WORK, CONFIRMATION
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId])
}

// Этап установки конкретного заказа
model InstallationStage {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
  type        String    // CLIENT_ACTION, ADMIN_WORK, CONFIRMATION
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  sortOrder   Int       @default(0)
  completedAt DateTime?
  completedBy String?   // userId кто завершил
  comments    StageComment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
}

// ==================== ЧАТ И СООБЩЕНИЯ ====================

// Сообщения в общем чате заказа
model OrderMessage {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  content     String        @db.Text
  files       String?       @db.Text // JSON array файлов
  isRead      Boolean       @default(false) // deprecated, use status
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([userId])
}

// Комментарии к этапу
model StageComment {
  id        String            @id @default(cuid())
  stageId   String
  stage     InstallationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  content   String            @db.Text
  files     String?           @db.Text // JSON array файлов
  createdAt DateTime          @default(now())

  @@index([stageId])
  @@index([userId])
}
